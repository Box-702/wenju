# =====================================================================
# .env.example —— 问剧环境变量模板（D-48 后口径）
#
# 使用：复制为 .env 后按需填写。
#   Copy-Item .env.example .env
#
# ⚠️ 模型接入**不在这里配**：对话/视觉/文生图/配音/视频全部走
#   应用内「设置 → 模型」贴 key（DB/BYOK 唯一权威，D-48）。
#   未配置时应用走演示模式并在界面引导贴 key。
#   .env 里的 CHAT_PROVIDER / *_API_KEY / VISION_* / IMAGE_* / TTS_*
#   等模型类变量已全部退役——写了也没人读，别再加回来。
#
# env 仅存两个豁免（都不是模型选择入口）：
#   DEEPSEEK_THINKING        行为开关（思考链）
#   MINIMAX_API_KEY_FALLBACKS 备用 key 故障转移安全网（欠费/失效时顶上）
#
# 有两类参数：一类由 pydantic `Settings` 直接读 .env；另一类（安全网、
# FFMPEG_PATH、LANGSMITH_*）是代码直接读 os.environ 的。两类都依赖入口
# 调用 `config.bootstrap_env()`——`app/main.py` 与 `app/cli.py` 已这样做。
# 自己写脚本时记得也调一次，否则会静默取默认值。
# =====================================================================

# ---------- 行为开关（豁免①） ----------
# DeepSeek 思考链：false=直出 content（快约 6 倍）；true=深度推理。
DEEPSEEK_THINKING=false

# ---------- 备用 key 安全网（豁免②） ----------
# MiniMax 主 key 在 DB 里配；这里的备用串在主 key 欠费/429 时自动顶上，
# 顺序即优先级。坏 key 进冷却，充值后冷却到期自动复活，无需重启。
# MINIMAX_API_KEY_FALLBACKS=
# 旧写法别名（与上一行等价，同时存在时按出现顺序合并去重）：
# MINIMAX_API_KEYS=
# 冷却时长（秒），缺省 600。
# KEY_COOLDOWN_SEC=600

# ---------- 业务数据库 ----------
# 默认即产品主目录 ~/.wenju/app.db（仿 Codex：用户数据跟着用户走；
# WENJU_HOME 环境变量可整体搬家）。留空即可，一般不用写：
# DATABASE_URL=sqlite:///C:/Users/你/.wenju/app.db
# 需要 Postgres 时先 `docker compose up -d`，再换成：
# DATABASE_URL=postgresql+psycopg://script:script@localhost:5432/script_agent

# ---------- Agent 工作流 checkpointer ----------
# memory=进程内（零依赖，开发默认）；postgres=跨请求/跨重启恢复被中断的审阅图。
CHECKPOINTER=memory
# CHECKPOINT_DSN=postgresql://script:script@localhost:5432/script_agent

# ---------- 输出语言 / 服务 ----------
OUTPUT_LANGUAGE=zh-CN
# 默认只监听本机（服务无鉴权）；确需局域网访问再改为 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000

# ---------- 工作目录 ----------
# persist=true：剧本/版本/导出 以文件写到工作区（不存在自动创建）；
# persist=false：只在应用内，不落盘（数据仍在数据库里）。
# 默认根 = ~/.wenju/workspace/<剧名>/（01_原稿 … 07_成片 分层）。
WORKSPACE_PERSIST=true
# WORKSPACE_ROOT=D:\wenju-work

# ---------- 视频生成全局策略 ----------
# 首次生成用低挡位快速廉价出片，满意后再按高清晰度重生成。
# VIDEO_DEFAULT_RESOLUTION=768P
# 孤儿任务巡检：把「DB 说还在跑、内存没人盯」的任务重新挂回轮询（不会重复提交）。
# VIDEO_SWEEPER_ENABLED=true
# VIDEO_SWEEPER_INTERVAL_SEC=60

# ---------- 成片质检（需视觉模型 key，在设置里配；判定只对致命问题 FAIL） ----------
# VIDEO_QA_ENABLED=true
# VIDEO_QA_MAX_REROLL=1
# VIDEO_QA_FRAMES=5
# ffmpeg 路径（抽帧/拼接用；留空用 PATH 里的 ffmpeg，再退 imageio-ffmpeg 自带）
# FFMPEG_PATH=

# ---------- 配音混音 ----------
# 台词混音时的环境音音量（0-1），防止人声被盖住。
# DUBBING_BG_VOLUME=0.25

# ---------- 剧本评审打分 ----------
# ENABLE_REVIEW_SCORING=true
# REVIEW_SCORE_THRESHOLD=75

# ---------- LangSmith 监控（可选） ----------
# 开启后 LangGraph/LLM 运行轨迹自动上报；启动时映射为 LANGCHAIN_* 环境变量。
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=script-agent
